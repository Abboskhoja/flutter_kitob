{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "git clone --depth 1 -b 3.47.7 https://github.com/flutter/flutter.git .flutter-sdk && .flutter-sdk/bin/flutter config --no-analytics && .flutter-sdk/bin/flutter precache --web",
  "buildCommand": ".flutter-sdk/bin/flutter build web --release",
  "outputDirectory": "build/web",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(index.html|flutter_service_worker.js|flutter_bootstrap.js)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
